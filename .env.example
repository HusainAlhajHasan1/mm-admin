# ---------------------------------------------------------------------------
# Mattermost Admin Dashboard — configuration
# Copy this file to .env and edit it. Restart the dashboard after changes:
#   sudo systemctl restart mm-admin
# ---------------------------------------------------------------------------

# Base URL of your Mattermost server (same LXC by default).
MM_URL=http://127.0.0.1:8065

# Optional Personal Access Token of a System Admin account. It is used by the
# background presence poller and to resolve agent usernames without an active
# browser session. If empty, the dashboard uses the last admin login session
# (valid for up to 30 days).
# MM_ADMIN_TOKEN=

# Where the dashboard listens. 0.0.0.0 makes it reachable via the LXC IP.
DASH_HOST=0.0.0.0
DASH_PORT=8090

# Secret used to sign the session cookie. Generated automatically when empty.
# DASH_SECRET=

# Timezone for displayed and exported times. Defaults to the system timezone.
# APP_TIMEZONE=Europe/Berlin

# How often online/offline statuses are polled (seconds, minimum 20).
STATUS_POLL_SECONDS=60

# ---- Full chat visibility (optional but recommended) ----------------------
# Mattermost blocks System Admins from reading other users' DMs through its
# API. Point this at a SELECT-only database user to enable full access.
# PostgreSQL:
# DATABASE_URL=postgresql://mm_dash:CHANGE_ME@127.0.0.1:5432/mattermost
# MySQL / MariaDB:
# DATABASE_URL=mysql://mm_dash:CHANGE_ME@127.0.0.1:3306/mattermost

# ---- Location tracking ----------------------------------------------------
# API key for the optional location agent. Generated automatically when empty.
# LOCATION_API_KEY=

# Enable external IP geolocation (ipwho.is / ip-api.com).
GEOIP_ENABLED=1

# Set to 1 when the dashboard runs behind a reverse proxy so the real client
# IP is read from X-Forwarded-For.
TRUST_PROXY=0

# Set to 1 to accept self-signed TLS certificates from Mattermost.
DASH_INSECURE_TLS=0

# Set to 1 when the dashboard itself is served over HTTPS.
DASH_COOKIE_SECURE=0

# Public base URL embedded in generated agent downloads.
# PUBLIC_URL=http://192.168.1.50:8090

# ---- mmctl (optional) -----------------------------------------------------
# Used as a fallback for operations the REST API forbids (permanent deletion).
# Auto-detected at /opt/mattermost/bin/mmctl and in PATH.
# MMCTL_PATH=/opt/mattermost/bin/mmctl
# OS user that owns the Mattermost install (used with runuser when running as root).
# MM_OS_USER=mattermost
