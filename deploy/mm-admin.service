[Unit]
Description=Mattermost Admin Dashboard
Documentation=file:///opt/mm-admin/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mm-admin
Group=mm-admin
WorkingDirectory=/opt/mm-admin
EnvironmentFile=-/opt/mm-admin/.env
ExecStart=/opt/mm-admin/venv/bin/python /opt/mm-admin/app.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/mm-admin/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
